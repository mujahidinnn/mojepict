# Copy this file to .env.local and fill in the keys you want to enable.
# .env.local is gitignored — never commit real API keys.
#
# Both are optional: every tool keeps working with zero configuration using
# local, in-browser processing. Setting a key just unlocks that tool's
# "AI Enhanced" mode.
#
# Each variable accepts a single key, or a comma-separated list of keys
# (e.g. "key1,key2,key3"). If a request fails because a key is invalid or
# out of quota, the API route automatically retries the next key in the
# list before giving up.

# remove-bg tool -> https://www.remove.bg/dashboard#api-key (free tier available)
REMOVE_BG_API_KEY=

# image-compressor tool -> https://tinify.com/dashboard/api (free tier: 500 images/month)
TINIFY_API_KEY=
